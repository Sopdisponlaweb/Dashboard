# Supabase local. `supabase start` entregará estos valores.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_local_publishable_key

# Nunca uses el prefijo NEXT_PUBLIC_ para claves privilegiadas.
SUPABASE_SECRET_KEY=replace_with_local_secret_key

# Asistente IA (opcional). Con al menos una de estas, /asistente se activa.
ANTHROPIC_API_KEY=

# Groq: inferencia muy rápida sobre modelos abiertos (Llama, DeepSeek, Gemma).
# Administra tu clave en https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: acceso a varios modelos (GPT, Gemini, Llama, DeepSeek, Mistral...) con una sola clave.
# Crea la tuya en https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Sopdisponal Admin
