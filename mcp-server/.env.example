# URL y llave pública (anon/publishable) de tu instancia de Supabase.
# Local: usa los mismos valores que sopdisponal-admin/.env.local
#   SUPABASE_URL = NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_ANON_KEY = NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# Credenciales de TU propia cuenta en Sopdisponal. El servidor MCP inicia sesión como
# tú, así que solo puede hacer lo que tus permisos ya te permiten en la plataforma.
# No uses una cuenta compartida ni la llave de servicio (service_role).
MCP_SUPABASE_EMAIL=
MCP_SUPABASE_PASSWORD=
